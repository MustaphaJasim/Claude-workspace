{
  "permissions": {
    "deny": [
      "mcp__Gmail__send_message",
      "mcp__Gmail__reply",
      "mcp__Gmail__forward",
      "mcp__Gmail__create_filter",
      "mcp__Apollo_io__apollo_emailer_messages_send_now",
      "mcp__Apollo_io__apollo_emailer_messages_create",
      "mcp__Apollo_io__apollo_emailer_campaigns_approve",
      "mcp__Apollo_io__apollo_emailer_campaigns_add_contact_ids",
      "mcp__HubSpot__manage_marketing_email",
      "mcp__Zapier__execute_zapier_write_action",
      "mcp__Zapier__run_workflow",
      "mcp__Zapier__run_workflow_draft",
      "mcp__Zapier__create_workflow",
      "mcp__Zapier__enable_workflow",
      "mcp__Zapier__publish_workflow_draft",
      "mcp__Apollo_io__apollo_email_account_purchase_create",
      "mcp__Apollo_io__apollo_domain_purchase_index",
      "mcp__TheirStack__cancel_billing_invoice",
      "mcp__TheirStack__cancel_subscription",
      "mcp__TheirStack__add_member_to_team"
    ],
    "ask": [
      "mcp__ringover__sms_send",
      "mcp__ringover__sms_opt_out_add"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/westmont-sms-outreach/scripts/sms_guard.py\" prompt",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__ringover__sms_send|mcp__ringover__sms_opt_out_remove|Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/westmont-sms-outreach/scripts/sms_guard.py\" pre",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__ringover__sms_send",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/westmont-sms-outreach/scripts/sms_guard.py\" post",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__ringover__sms_send",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/westmont-sms-outreach/scripts/sms_guard.py\" fail",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
